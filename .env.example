# ---------------------------------------------------------------------------
# Azure OpenAI credentials
# Copy this file to `.env` and fill in the values from the Azure Portal:
#   Azure Portal -> your Azure OpenAI resource -> "Keys and Endpoint"
#   MINI_MODEL_NAME is your *deployment* name (your name for the model),
#   not necessarily the base model name.
# ---------------------------------------------------------------------------

LLM_ENDPOINT_MINI_MODEL=https://your-resource-name.openai.azure.com/
LLM_ENDPOINT_MINI_MODEL_APIKEY=paste-your-key-here
MINI_MODEL_NAME=gpt-4o-mini

# API version must be >= 2024-06-01 for parallel tool calls.
LLM_API_VERSION=2024-10-21

# --- Optional tuning -------------------------------------------------------
# Lower temperature = the model follows the tool rules more literally.
LLM_TEMPERATURE=0.2
# Safety valve: how many times the agent may loop (call tools) for one message.
MAX_TOOL_ITERATIONS=6
# Port the web UI is served on.
APP_PORT=8000
