# ---------------------------------------------------------------------------
# Azure OpenAI
#   Azure Portal -> your Azure OpenAI resource -> "Keys and Endpoint"
#   MINI_MODEL_NAME is your *deployment* name, not necessarily the model name.
# ---------------------------------------------------------------------------
LLM_ENDPOINT_MINI_MODEL=https://your-resource-name.openai.azure.com/
LLM_ENDPOINT_MINI_MODEL_APIKEY=paste-your-key-here
MINI_MODEL_NAME=gpt-4o-mini
LLM_API_VERSION=2024-10-21          # >= 2024-06-01 for parallel tool calls

# ---------------------------------------------------------------------------
# Database
#   Default: local SQL Server over Windows authentication (no password needed).
#   The app creates the database and seeds it on first run.
#
#   PostgreSQL:  DATABASE_URL=postgresql+psycopg2://user:pass@localhost/bitesbytes
#   SQLite:      DATABASE_URL=sqlite:///bitesbytes.db
# ---------------------------------------------------------------------------
DATABASE_URL=mssql+pyodbc://@localhost:1433/BitesBytes?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes

# --- Optional tuning -------------------------------------------------------
LLM_TEMPERATURE=0.2        # lower = follows the tool rules more literally
MAX_TOOL_ITERATIONS=6      # safety valve against infinite tool loops
SESSION_DAYS=14            # how long a login cookie stays valid
APP_PORT=8000
